EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Places credentials are NOT an app env var: the call goes through a
# Supabase Edge Function so the key never ships in the RN bundle. Set it as
# a Supabase secret instead, e.g.:
#   supabase secrets set GOOGLE_PLACES_API_KEY=...
# See supabase/functions/nearby-places and docs/db-schema.md.
#
# Music search (supabase/functions/mood-track) uses Deezer's public API,
# which needs no key/secret at all.
