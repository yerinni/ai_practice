EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Spotify Web API (Authorization Code + PKCE for user login; falls back to
# Client Credentials for MVP-stage playlist recommendations without login)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Google Places API — call is proxied through a Supabase Edge Function in
# production so this key never ships in the client bundle. Used locally only
# if you point the app at a dev proxy that needs it injected.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
