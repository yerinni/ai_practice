EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Spotify and Google Places credentials are NOT app env vars: both calls go
# through Supabase Edge Functions so the secrets never ship in the RN bundle.
# Set them as Supabase secrets instead, e.g.:
#   supabase secrets set SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=...
# See supabase/functions/spotify-mood-playlist and docs/db-schema.md.
